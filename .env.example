# Interfaz y puerto locales. En producción, mantener HOST en loopback para que
# sólo Nginx local pueda acceder directamente al proceso Node.
HOST=127.0.0.1
PORT=3005

# En producción se rechazan solicitudes HTTP no seguras y las claves VAPID
# y RATE_LIMIT_SECRET deben suministrarse desde el entorno/gestor de secretos.
NODE_ENV=development

# IP/CIDR o rango nombrado de Express para el reverse proxy que establece
# X-Forwarded-Proto. "loopback" es apropiado para Nginx en el mismo host.
# Nunca uses 1, true, * o all. Para Nginx en otra red usa su IP/CIDR exacto.
TRUST_PROXY=loopback

# Llaves VAPID para Notificaciones Web Push
# Obligatorias en producción. En desarrollo se usa un archivo local 0600 fuera de Git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@prisma.com.py

# Obligatorio en producción: secreto independiente de al menos 32 bytes para
# HMAC de rate limits. Development/test usa la clave VAPID local como fallback.
RATE_LIMIT_SECRET=
